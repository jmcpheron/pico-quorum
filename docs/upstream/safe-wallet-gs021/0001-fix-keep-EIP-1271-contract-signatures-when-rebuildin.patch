diff --git a/packages/utils/src/utils/__tests__/safeTransaction.test.ts b/packages/utils/src/utils/__tests__/safeTransaction.test.ts
new file mode 100644
index 0000000..c45dbc5
--- /dev/null
+++ b/packages/utils/src/utils/__tests__/safeTransaction.test.ts
@@ -0,0 +1,64 @@
+import { buildSignatureBytes } from '@safe-global/protocol-kit'
+import { toSafeSignature } from '../safeTransaction'
+
+// A 2-of-2 Safe 1.5.0 whose owners are an EOA and a passkey signer (SafeWebAuthnSignerProxy), both
+// made from throwaway keys, on a local fork of Base Sepolia. The two confirmations are in the form
+// the Transaction Service returns them. EXECUTED_SIGNATURES is what the Safe's
+// SafeMultiSigTransaction event logged when execTransaction ran with them on that fork. Laid out
+// the old way (both confirmations as plain signatures) the same call reverted with GS021.
+const EOA_OWNER = '0x27d0D792caa1d3667bc712062498A4b5BB89A43E'
+const EOA_SIGNATURE =
+  '0xf956ce839c6ea4d257b7252385e0d66ce7f55a67e7078cc3658748a20a2141246a9f075af7cb2ed805269c59c186be73c618d6fb98bae2599aad634b261d6ef71b'
+const CONTRACT_OWNER = '0x4D5Df238e4aBe5b6945BF416460F510D25155E91'
+const CONTRACT_SIGNATURE =
+  ''
+const EXECUTED_SIGNATURES =
+  ''
+
+describe('toSafeSignature', () => {
+  it('keeps an EOA signature as it is', () => {
+    const signature = toSafeSignature(EOA_OWNER, EOA_SIGNATURE)
+
+    expect(signature.isContractSignature).toBe(false)
+    expect(signature.staticPart()).toBe(EOA_SIGNATURE)
+    expect(signature.dynamicPart()).toBe('')
+  })
+
+  it('turns a stored contract signature into a contract signature with only its data', () => {
+    const signature = toSafeSignature(CONTRACT_OWNER, CONTRACT_SIGNATURE)
+
+    expect(signature.isContractSignature).toBe(true)
+    // 65-byte static part + 32-byte length word are dropped, the rest is the EIP-1271 data
+    expect(signature.data).toBe(`0x${CONTRACT_SIGNATURE.slice(2 + 2 * (65 + 32))}`)
+  })
+
+  it('lays out an EOA and a contract signature the way the Safe executed them', () => {
+    const bytes = buildSignatureBytes([
+      toSafeSignature(EOA_OWNER, EOA_SIGNATURE),
+      toSafeSignature(CONTRACT_OWNER, CONTRACT_SIGNATURE),
+    ])
+
+    expect(bytes.toLowerCase()).toBe(EXECUTED_SIGNATURES.toLowerCase())
+  })
+
+  it('points the contract signature past every static part', () => {
+    const bytes = buildSignatureBytes([
+      toSafeSignature(EOA_OWNER, EOA_SIGNATURE),
+      toSafeSignature(CONTRACT_OWNER, CONTRACT_SIGNATURE),
+    ])
+    // signatures are sorted by owner; the contract owner's static part holds its offset in its second word
+    const slot = EOA_OWNER.toLowerCase() < CONTRACT_OWNER.toLowerCase() ? 1 : 0
+    const start = 2 + 2 * (65 * slot + 32)
+    const offset = parseInt(bytes.slice(start, start + 64), 16)
+
+    expect(offset).toBe(2 * 65)
+  })
+
+  it('leaves a v = 0 signature it cannot parse as a plain signature', () => {
+    const truncated = CONTRACT_SIGNATURE.slice(0, CONTRACT_SIGNATURE.length - 64)
+    const signature = toSafeSignature(CONTRACT_OWNER, truncated)
+
+    expect(signature.isContractSignature).toBe(false)
+    expect(signature.staticPart()).toBe(truncated)
+  })
+})
diff --git a/packages/utils/src/utils/safeTransaction.ts b/packages/utils/src/utils/safeTransaction.ts
index 1b1d8d1..7a60c88 100644
--- a/packages/utils/src/utils/safeTransaction.ts
+++ b/packages/utils/src/utils/safeTransaction.ts
@@ -1,5 +1,5 @@
-import type { SafeTransaction, SafeTransactionData, SafeVersion } from '@safe-global/types-kit'
-import { calculateSafeTransactionHash } from '@safe-global/protocol-kit'
+import type { SafeSignature, SafeTransaction, SafeTransactionData, SafeVersion } from '@safe-global/types-kit'
+import { calculateSafeTransactionHash, EthSafeSignature } from '@safe-global/protocol-kit'
 import type { Chain } from '@safe-global/store/gateway/AUTO_GENERATED/chains'
 
 /**
@@ -87,3 +87,37 @@ export const getNestedExecTransactionHashFromInfo = ({
     txData,
   })
 }
+
+const STATIC_PART_HEX_LENGTH = 65 * 2
+
+/**
+ * Turns a confirmation as the Transaction Service returns it back into a Core SDK signature.
+ *
+ * An owner that is a contract (a nested Safe, or a passkey signer such as SafeWebAuthnSignerProxy)
+ * confirms with an EIP-1271 contract signature: a 65-byte static part `{owner}{offset}{00}`
+ * followed by `{length}{signature data}`, stored with the offset pointing right after its own
+ * static part. Added to a SafeTransaction as a plain signature, it is concatenated whole and keeps
+ * that offset, which points inside the static part as soon as there are two or more signatures,
+ * so the Safe reverts with GS021. Added as a contract signature, `buildSignatureBytes` lays it out.
+ */
+export const toSafeSignature = (signer: string, signature: string): SafeSignature => {
+  const hex = signature.startsWith('0x') ? signature.slice(2) : signature
+  const isContractSignature = hex.length > STATIC_PART_HEX_LENGTH && hex.slice(128, 130) === '00'
+
+  if (isContractSignature) {
+    const offset = Number.parseInt(hex.slice(64, 128), 16) * 2
+    const length = Number.parseInt(hex.slice(offset, offset + 64), 16) * 2
+    const data = hex.slice(offset + 64, offset + 64 + length)
+
+    if (
+      Number.isSafeInteger(offset) &&
+      offset >= STATIC_PART_HEX_LENGTH &&
+      Number.isSafeInteger(length) &&
+      data.length === length
+    ) {
+      return new EthSafeSignature(signer, `0x${data}`, true)
+    }
+  }
+
+  return new EthSafeSignature(signer, signature)
+}
