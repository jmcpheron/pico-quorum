#!/bin/sh
# The Family Safe for the console: a mock of Safe's transaction service on this Mac, with two
# simulated co-signers (Alice, Bob), in front of a simulated Safe (`tools/quorum serve`) or a real
# one on an Anvil fork of Base (`tools/quorum up`). The rest drive it; `doctor` checks the setup.
# Details: tools/mock-tx-service/README.md.
cd "$(dirname "$0")/.." || exit 1
[ -d tools/mock-tx-service/node_modules ] || (cd tools/mock-tx-service && npm ci --silent --no-audit --no-fund) || exit 1
exec node tools/mock-tx-service/cli.mjs "$@"
