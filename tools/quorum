#!/bin/sh
# The simulated Safe for the console: a mock of Safe's transaction service on this Mac, with two
# simulated co-signers (Alice, Bob). `tools/quorum serve` runs it; the rest drive it.
# Details: tools/mock-tx-service/README.md.
cd "$(dirname "$0")/.." || exit 1
[ -d tools/mock-tx-service/node_modules ] || (cd tools/mock-tx-service && npm install --silent --no-audit --no-fund) || exit 1
exec node tools/mock-tx-service/cli.mjs "$@"
