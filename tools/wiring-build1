        text(640 + tipw, y - 2, name, 11, "#111", "start", True)
        text(640 + tipw, y + 12, sub, 9, GREY)
    P1Y, P2Y = 770, 930
    plug(P1Y, "P1: 3.5 mm TRRS plug", "goes in J1", 16)
    plug(P2Y, "P2: 2.5 mm TRRS plug", "goes in J2", 12)
    # breakout between the plugs
    rect(400, 812, 220, 76, "#1e5aa8", "#123a70", 8, 2)
    text(510, 846, "ATECC608 breakout", 11, "#fff", "middle", True)
    text(510, 860, "(answers at 0x60)", 9, "#dbe7ff", "middle")
    text(510, 874, "own pull-ups to VIN", 9, "#dbe7ff", "middle")
    for name, x in (("GND", SEG["S"]), ("SCL", SEG["R1"]), ("SDA", SEG["T"])):
        pad(x, 812); text(x + 8, 826, name, 8.5, "#fff", "start", True)
    for name, x in (("GND", SEG["S"]), ("VIN", SEG["T"])):
        pad(x, 888); text(x + 8, 884, name, 8.5, "#fff", "start", True)
    wire([(SEG["T"], P1Y + 9), (SEG["T"], 807)], BLU)
    wire([(SEG["R1"], P1Y + 9), (SEG["R1"], 807)], YEL)
    wire([(SEG["S"], P1Y + 9), (SEG["S"], 807)], BLK)
    wire([(SEG["R2"], P1Y + 9), (SEG["R2"], 792), (SEG["S"], 792)], GRN); dot(SEG["S"], 792, BLK)
    wire([(SEG["S"], 893), (SEG["S"], P2Y - 9)], BLK)
    wire([(SEG["T"], 893), (SEG["T"], P2Y - 9)], ORG, 3)
    for s in ("R2", "R1"):
        wire([(SEG[s], P2Y - 9), (SEG[s], P2Y - 22)], MAG, 1.5, dash=True)
    text(80, 792, "P1 ring 2 jumpered to P1 sleeve:", 9.5, GRN, "start", True)
    text(80, 805, "that is how the console sees", 9.5, GRN); text(80, 818, "a key (DETECT reads low)", 9.5, GRN)
    text(80, 870, "split the GND wire:", 9.5, BLK, "start", True)
    text(80, 883, "both sleeves are ground", 9.5, BLK)
    text(80, 910, "P2 rings: nothing on an ATECC key.", 9.5, MAG)
    text(80, 923, "Trust M key: ring 1 = its RST pad", 9.5, MAG)
    text(80, 956, "optional: 100 nF across VIN-GND at the plug", 9.5, GREY)

    # ----------------------------------------------------------------------------- rules box
    RX0, RY0 = 800, 700
    rect(RX0, RY0, 616, 282, "#fff4f2", RED, 6, 1.5)
    text(RX0 + 14, RY0 + 24, "Rules that prevent damage", 13, RED, "start", True)
    lines = [
        "1. Screen VCC is 3.3 V (pin 36). Not VBUS, not 5 V.",
        "2. Key power (GP6) is OFF before a plug goes in or comes out.",
        "   Every plug tip wipes past every jack contact, sleeve included:",
        "   a live GP6 on J2's tip gets shorted to ground on the way in.",
        "   The firmware turns GP6 on only after DETECT has read low",
        "   for 200 ms, and off the moment it goes high.",
        "3. Never plug the key into a phone, laptop or audio jack.",
        "   Those drive the tip and put mic bias on a ring.",
        "4. No 18650 without a PROTECTED TP4056 (the DW01 kind).",
        "   Build 1 runs on USB; the cell is a later build.",
        "5. Config lock and data lock on the ATECC are permanent.",
        "   Build 1 only reads the chip. ALLOW_LOCK stays False.",
        "6. Meter SDA/SCL/VIN/GND at the plugs before the first plug-in.",
    ]
    y = RY0 + 46
    for line in lines:
        text(RX0 + 14, y, line, 10, "#3a1410" if not line.startswith("   ") else "#6b3b36"); y += 17

    add("</svg>")
    return "\n".join(out) + "\n"


def check():
    """Compare PINS with the tables in BUILD1.md and HANDOFF.md and the constants in firmware/bench1.py."""
    bad = 0
    want = {(p, c): (gp, n) for p, c, s, gp, n in PINS}
    for path in ("hardware/wiring/BUILD1.md", "hardware/HANDOFF.md"):
        got = {}
        part = None
        for line in open(path):
            m = re.match(r"<!-- pins: (\w+) -->", line.strip())
            if m:
                part = m.group(1); continue
            if not part:
                continue
            if not line.startswith("|"):
                part = None; continue
            cells = [c.strip().strip("*`") for c in line.strip().strip("|").split("|")]
            if line.startswith("|---") or cells[0] in ("contact", "part, contact"):
                continue
            key = tuple(cells[0].split(" ", 1)) if part == "summary" else (part, cells[0])
            got[key] = (cells[2], int(cells[3]))
        for k in sorted(set(want) | set(got)):
            if want.get(k) != got.get(k):
                print("%s %s %s: table says %s, PINS says %s" % (path, k[0], k[1], got.get(k), want.get(k))); bad += 1
    src = open("firmware/bench1.py").read()
    consts = dict((k, int(v)) for k, v in re.findall(r"^([A-Z_]+) = (\d+)\b", src, re.M))
    expect = {"SCR_DC": "GP8", "SCR_CS": "GP9", "SCR_SCK": "GP10", "SCR_MOSI": "GP11", "SCR_RST": "GP12", "SCR_BL": "GP13",
              "ENC_A": "GP2", "ENC_B": "GP3", "ENC_SW": "GP1", "KEY_SDA": "GP4", "KEY_SCL": "GP5", "KEY_PWR": "GP6",
              "KEY_DETECT": "GP7", "KEY_RST": "GP26", "KEY_ID": "GP27"}
    gps = {gp for p, c, s, gp, n in PINS}
    for name, gp in expect.items():
        assert gp in gps, gp
        if consts.get(name) != int(gp[2:]):
            print("bench1.py %s = %s, PINS says %s" % (name, consts.get(name), gp)); bad += 1
    # the physical pin numbers follow from the GPIO numbers; catch a typo in PINS itself
    phys = {0: 1, 1: 2, 2: 4, 3: 5, 4: 6, 5: 7, 6: 9, 7: 10, 8: 11, 9: 12, 10: 14, 11: 15, 12: 16, 13: 17, 14: 19, 15: 20,
            16: 21, 17: 22, 18: 24, 19: 25, 20: 26, 21: 27, 22: 29, 26: 31, 27: 32, 28: 34}
    for p, c, s, gp, n in PINS:
        if gp.startswith("GP") and phys[int(gp[2:])] != n:
            print("PINS %s %s: %s is pin %d, not %d" % (p, c, gp, phys[int(gp[2:])], n)); bad += 1
        if gp == "GND" and n not in (3, 8, 13, 18, 23, 28, 33, 38):
            print("PINS %s %s: pin %d is not a GND" % (p, c, n)); bad += 1
    print("pins agree" if not bad else "%d mismatches" % bad)
    return bad


if __name__ == "__main__":
    if "--check" in sys.argv:
        sys.exit(1 if check() else 0)
    open("hardware/wiring/build1-wiring.svg", "w").write(build())
    print("wrote hardware/wiring/build1-wiring.svg")
