    text(LX - 14, ly(20) + 4, "reserved, A = Sign: GP15, pin 20", 9.5, GREY, "end")
    text(NX, ry(29) + 4, "free: GP0, GP14, GP16, GP18, GP20, GP22", 9.5, "#2e7d4f")
    text(NX, 186, "dashed ring on the board = reserved pin, leave it free", 9.5, GREY)

    # ----------------------------------------------------------------------------- the key
    KX0 = 24
    text(KX0, 718, "The key, Build 1: the ATECC608 STEMMA breakout on a cut STEMMA QT cable, soldered to two plugs", 13, "#111", "start", True)
    text(KX0, 734, "Map each cable wire to the breakout's VIN / GND / SDA / SCL pads with a meter first (hardware/wiring/SOLDERING.md, section 1).", 9.5, GREY)
    SEG = {"S": 430, "R2": 485, "R1": 535, "T": 590}
    def plug(y, name, sub, tipw):
        x0 = 380
        rect(x0 - 70, y - 14, 70, 28, "#555", "#222", 6)     # handle
        text(x0 - 35, y + 4, "handle", 8.5, "#eee", "middle")
        edges = [(400, 460, "S"), (460, 510, "R2"), (510, 560, "R1"), (560, 620, "T")]
        for a, b, s in edges:
            rect(a, y - 9, b - a - 3, 18, "#d9d9d9" if s != "S" else "#bdbdbd", "#555", 2, 1)
