    text(NX, ry(34) + 4, "34 GP28: reserved, battery sense (hardware/wiring/SOLDERING.md)", 9.5, GREY)
    text(NX, ry(32) + 4, "32 GP27: KEY ID, J2 ring 2", 10, MAG, bold=True)
    text(NX, ry(31) + 4, "31 GP26: KEY RST, J2 ring 1", 10, MAG, bold=True)
    text(NX, ry(27) + 4, "27 GP21: reserved, Y = Reject", 9.5, GREY)
    text(NX, ry(25) + 4, "25 GP19: reserved, X", 9.5, GREY)
