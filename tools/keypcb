#!/usr/bin/env python3
# The key PCBs in hardware/key-pcb (see its README.md and ORDERING.md), and the console boards in
# hardware/console-pcb, hardware/console-a and hardware/console-pocket. Needs KiCad's kicad-cli: 9
# for rev A, 10 for the rest.
#
#   tools/keypcb check [board]    ERC on the schematic, then DRC with schematic parity on the board
#   tools/keypcb fab [board]      writes <board>/fab/: the Gerber + drill zip, and the BOM and CPL
#                                 in JLCPCB's column format
#   tools/keypcb render [board]   top and bottom 3D renders into <board>/fab/ (part bodies show only
#                                 if KiCad's 3D models are installed; the pads, fingers and silk always do)
#   tools/keypcb fill [board]     fills the copper pours and saves the board (KiCad's own Python, for
#                                 pcbnew): a board written as text has its zones unfilled
#   tools/keypcb calc ...         the numbers behind the design: insert, rise, power, spice
#                                 (hardware/key-pcb/keycalc.py, run with uv; needs no KiCad)
#   tools/keypcb gen-cd           rewrites proposals key-c-usbc and key-d-pogo from gen_cd.py (KiCad's own
#                                 Python, for pcbnew); rev A's boards are never touched
#   tools/keypcb gen-console      rewrites console-pcb/console-a from hardware/console-pcb/gen_console.py,
#                                 the same way
#   tools/keypcb gen-console-a    rewrites console-a/console-a (the Waveshare-pin board) from
#                                 hardware/console-a/gen.py
#   tools/keypcb gen-console-pocket  rewrites console-pocket (the Pico-on-the-back board) from
#                                 hardware/console-pocket/gen_console.py: plain Python, no KiCad,
#                                 and it ends with its own self-check
#
# board is one of the key-* or console-* folders; without one, every board. A name used in two
# folders (console-a) is written with its folder: console-pcb/console-a, console-a/console-a.
# check on a board whose folder has a gen.py also runs `gen.py check` (its pin map against the
# firmware). Run from anywhere.
import csv, glob, io, os, re, shutil, subprocess, sys, tempfile, zipfile

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hardware", "key-pcb")
ROOT = os.path.normpath(ROOT)
CONSOLE = os.path.join(os.path.dirname(ROOT), "console-pcb")
CONSOLE_A = os.path.join(os.path.dirname(ROOT), "console-a")
CONSOLE_POCKET = os.path.join(os.path.dirname(ROOT), "console-pocket")

# Gerber layers JLCPCB wants for a 2-layer board. Paste layers are only used for assembly orders,
# and harmless on a bare-board order.
LAYERS = "F.Cu,B.Cu,F.Paste,B.Paste,F.Silkscreen,B.Silkscreen,F.Mask,B.Mask,Edge.Cuts"


def _board_dirs():
    """board name -> its folder. A folder name found in more than one place gets its parent's name
    in front: console-pcb/console-a and console-a/console-a."""
    dirs = sorted(d for d in glob.glob(os.path.join(ROOT, "key-*")) + glob.glob(os.path.join(CONSOLE, "console-*"))
                  + glob.glob(os.path.join(CONSOLE_A, "console-*")) + glob.glob(os.path.join(CONSOLE_POCKET, "console-*"))
                  if os.path.isdir(d))
    base = [os.path.basename(d) for d in dirs]
    return {(b if base.count(b) == 1 else os.path.basename(os.path.dirname(d)) + "/" + b): d for b, d in zip(base, dirs)}


def boards(arg):
    names = list(_board_dirs())
    if arg:
        if arg not in names:
            sys.exit(f"no board {arg!r}; boards: {', '.join(names)}")
        return [arg]
    return names


# On macOS kicad-cli lives inside the app bundle, not on the PATH
KICAD_CLI = shutil.which("kicad-cli") or next(
    (p for p in ("/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli",) if os.path.exists(p)), None)


def kicad(*args):
    r = subprocess.run([KICAD_CLI, *args], capture_output=True, text=True)
    if r.returncode not in (0, 5):  # 5: violations found, which the caller reads from the report
        sys.exit(f"kicad-cli {' '.join(args)} failed ({r.returncode}):\n{r.stdout}{r.stderr}")
    return r


def files(name):
    d = _board_dirs()[name]
    b = os.path.basename(d)
    return d, os.path.join(d, b + ".kicad_sch"), os.path.join(d, b + ".kicad_pcb")


def check(name):
    d, sch, pcb = files(name)
    ok = True
    gen = os.path.join(os.path.dirname(d), "gen.py")
    if os.path.basename(os.path.dirname(d)) != "key-pcb" and os.path.exists(gen):
        # the board's pin table against firmware/board.py and the emulator; plain Python, no KiCad
        r = subprocess.run([sys.executable, gen, "check"], capture_output=True, text=True)
        print(r.stdout.rstrip() or r.stderr.rstrip())
        ok = r.returncode == 0
    with tempfile.TemporaryDirectory() as t:
        rpt = os.path.join(t, "erc.rpt")
        kicad("sch", "erc", "--severity-all", "-o", rpt, sch)
        text = open(rpt).read()
        m = re.search(r"ERC messages: (\d+)\s+Errors (\d+)\s+Warnings (\d+)", text)
        print(f"{name}: ERC  {m.group(2)} errors, {m.group(3)} warnings")
        if m.group(1) != "0":
            ok = False
            print(text.split("\n", 4)[-1].rstrip())
        rpt = os.path.join(t, "drc.rpt")
        kicad("pcb", "drc", "--schematic-parity", "--severity-all", "-o", rpt, pcb)
        text = open(rpt).read()
        found = {k: int(v) for v, k in re.findall(r"\*\* Found (\d+) (DRC violations|unconnected pads|Footprint errors)", text)}
        print(f"{name}: DRC  {found.get('DRC violations')} violations, {found.get('unconnected pads')} unconnected, "
              f"{found.get('Footprint errors')} schematic-parity issues")
        if any(found.values()) or len(found) != 3:
            ok = False
            print(text.split("\n", 3)[-1].rstrip())
    return ok


def jlc_bom(name, sch, out, option=None):
    """JLCPCB's BOM: Comment, Designator, Footprint, LCSC Part #. Only parts with an LCSC number that
    are fitted; the rest (the fingers, a DNP resistor, a chip you solder yourself) stay off it.
    Returns each placed ref's "JLCPCB Rotation Offset" field (0 where a part has none).
    option names a second field (LCSC_FACTORY) whose number stands in where LCSC is empty: the parts
    JLCPCB fits only when you ask it to."""
    fields, labels = "Reference,Value,Footprint,LCSC,${DNP},JLCPCB Rotation Offset", "ref,value,fp,lcsc,dnp,rot"
    if option:
        fields, labels = fields + "," + option, labels + ",option"
    r = kicad("sch", "export", "bom", "--fields", fields,
              "--labels", labels, "--ref-range-delimiter", "", "-o", "/dev/stdout", sch)
    rows, offsets = {}, {}
    for row in csv.DictReader(io.StringIO(r.stdout)):
        lcsc = row["lcsc"] or (row.get("option") or "")
        if not lcsc or row["dnp"].strip():
            continue
        key = (row["value"], row["fp"].split(":")[-1], lcsc)
        rows.setdefault(key, []).append(row["ref"])
        offsets[row["ref"]] = float(row["rot"] or 0)
    with open(out, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Comment", "Designator", "Footprint", "LCSC Part #"])
        for (value, fp, lcsc), refs in sorted(rows.items(), key=lambda kv: kv[1]):
            w.writerow([value, ",".join(refs), fp, lcsc])
    return offsets


def jlc_cpl(pcb, refs, out):
    """JLCPCB's CPL: Designator, Mid X, Mid Y, Layer, Rotation, for the parts in the BOM (refs: ref ->
    rotation offset). Rotation is KiCad's plus the part's "JLCPCB Rotation Offset", where a board's
    generator knows JLCPCB's footprint turns differently (console-a does; the key boards don't).
    JLCPCB's preview still shows each part on the board, and that is where a pin 1 that landed in
    the wrong corner gets fixed otherwise (see ORDERING.md)."""
    with tempfile.TemporaryDirectory() as t:
        pos = os.path.join(t, "pos.csv")
        kicad("pcb", "export", "pos", "--format", "csv", "--units", "mm", "--side", "both",
              "--exclude-dnp", "--use-drill-file-origin", "-o", pos, pcb)
        rows = list(csv.DictReader(open(pos)))
    with open(out, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Designator", "Mid X", "Mid Y", "Layer", "Rotation"])
        for r in rows:
            if r["Ref"] in refs:
                side = "Top" if r["Side"] == "top" else "Bottom"
                w.writerow([r["Ref"], f'{float(r["PosX"]):.4f}mm', f'{float(r["PosY"]):.4f}mm', side,
                            f'{(float(r["Rot"]) + refs[r["Ref"]]) % 360:.0f}'])


def fab(name):
    d, sch, pcb = files(name)
    out = os.path.join(d, "fab")
    os.makedirs(out, exist_ok=True)
    with tempfile.TemporaryDirectory() as t:
        # every file measures from the board's drill/place origin, its bottom-left corner
        kicad("pcb", "export", "gerbers", "--layers", LAYERS, "--subtract-soldermask", "--use-drill-file-origin",
              "-o", t + "/", pcb)
        kicad("pcb", "export", "drill", "--format", "excellon", "--excellon-separate-th", "--drill-origin", "plot",
              "-o", t + "/", pcb)
        z = os.path.join(out, f"{os.path.basename(d)}-gerbers.zip")
        with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
            for p in sorted(os.listdir(t)):
                if p.endswith(".gbrjob"):
                    continue
                info = zipfile.ZipInfo(p, date_time=(2026, 1, 1, 0, 0, 0))  # same bytes on every run
                info.compress_type = zipfile.ZIP_DEFLATED
                zf.writestr(info, open(os.path.join(t, p), "rb").read())
        print(f"{name}: {os.path.relpath(z)} ({len(zipfile.ZipFile(z).namelist())} files)")
    refs = jlc_bom(name, sch, os.path.join(out, "bom.csv"))
    jlc_cpl(pcb, refs, os.path.join(out, "cpl.csv"))
    print(f"{name}: fab/bom.csv and fab/cpl.csv ({', '.join(sorted(refs)) or 'nothing to place'})")
    if "LCSC_FACTORY" in open(sch).read():
        # the same board with JLCPCB also fitting the parts you'd otherwise solder (console-a's Pico)
        alt = os.path.join(out, "factory-pico")
        os.makedirs(alt, exist_ok=True)
        more = jlc_bom(name, sch, os.path.join(alt, "bom.csv"), option="LCSC_FACTORY")
        jlc_cpl(pcb, more, os.path.join(alt, "cpl.csv"))
        print(f"{name}: fab/factory-pico/bom.csv and cpl.csv (adds {', '.join(sorted(set(more) - set(refs)))})")


def render(name):
    d, sch, pcb = files(name)
    out = os.path.join(d, "fab")
    os.makedirs(out, exist_ok=True)
    w, h, zoom = ("1600", "700", "2.2") if name.startswith("console-") else ("900", "1100", "1")   # the console lies flat
    for side in ("top", "bottom"):
        png = os.path.join(out, f"{os.path.basename(d)}-{side}.png")
        kicad("pcb", "render", "--side", side, "--quality", "high", "--width", w, "--height", h,
              "--background", "opaque", "--zoom", zoom, "-o", png, pcb)
        print(f"{name}: {os.path.relpath(png)}")


KICAD_PY = "/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3"
KICAD_PY = KICAD_PY if os.path.exists(KICAD_PY) else "python3"   # on Linux, KiCad's pcbnew is in the system Python

FILL = """import sys, pcbnew
b = pcbnew.LoadBoard(sys.argv[1])
pcbnew.ZONE_FILLER(b).Fill(b.Zones())
pcbnew.SaveBoard(sys.argv[1], b)
"""


def fill(name):
    """Fill the pours and save. pcbnew rewrites the file in its own layout, which is fine: from then
    on the KiCad files are the source of truth, as the generators' docstrings say."""
    d, sch, pcb = files(name)
    r = subprocess.run([KICAD_PY, "-c", FILL, pcb], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"fill {name} failed:\n{r.stdout}{r.stderr}")
    print(f"{name}: zones filled, {os.path.relpath(pcb)} saved")


def main():
    gens = {"gen-cd": os.path.join(ROOT, "gen_cd.py"), "gen-console": os.path.join(CONSOLE, "gen_console.py"),
            "gen-console-a": os.path.join(CONSOLE_A, "gen.py"),
            "gen-console-pocket": os.path.join(CONSOLE_POCKET, "gen_console.py")}
    if len(sys.argv) > 1 and sys.argv[1] in gens:
        py = KICAD_PY if sys.argv[1] != "gen-console-pocket" else "python3"
        os.execvp(py, [py, gens[sys.argv[1]], *sys.argv[2:]])
    if len(sys.argv) > 1 and sys.argv[1] == "calc":
        calc = os.path.join(ROOT, "keycalc.py")
        os.execvp("uv", ["uv", "run", "--quiet", "--python", "3.12", calc, *sys.argv[2:]])
    if len(sys.argv) < 2 or sys.argv[1] not in ("check", "fab", "render", "fill"):
        sys.exit(__doc__ or open(__file__).read().split("\nimport")[0])
    if not KICAD_CLI:
        sys.exit("kicad-cli not found: install KiCad 10 (https://www.kicad.org/download/)")
    cmd, arg = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else None)
    ok = True
    for name in boards(arg):
        if cmd == "check":
            ok &= check(name)
        elif cmd == "fab":
            fab(name)
        elif cmd == "fill":
            fill(name)
        else:
            render(name)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
