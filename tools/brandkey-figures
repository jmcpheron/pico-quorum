def key_xy(k, cx, cy):
    """Key k on the ring map: ring n holds the n-bit numbers, clockwise from the top. A key's
    children 2k and 2k + 1 sit just outside it on the next ring."""
    n = k.bit_length() - 1
    if n == 0:
        return cx, cy
    a = -math.pi / 2 + (k - (1 << n) + 0.5) / (1 << n) * 2 * math.pi
    return round(cx + 34 * n * math.cos(a), 1), round(cy + 34 * n * math.sin(a), 1)


