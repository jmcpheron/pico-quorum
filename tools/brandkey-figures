def chip_pair(f, x, y, left, right):
    f.rect(x, y, 256, 80, fill=PANEL, stroke=LINE)
    for i, (kind, name, state) in enumerate((left, right)):
        tx = x + 12 + i * 122
        fill, stroke, _, dash = KIND[kind]
        f.rect(tx, y + 14, 110, 52, fill=fill, stroke=stroke, rx=6, dash=dash, sw=1.5,
               fill_opacity="0.16" if kind in ("safe", "brand") else None)
        f.text(tx + 55, y + 36, name, 12, TEXT, "middle", bold=True)
        f.text(tx + 55, y + 54, state, 11, MUTED if kind == "empty" else TEXT, "middle")


def tag(f, x, y, color, a, b):
    f.rect(x, y, 256, 80, fill=color, stroke=color, sw=2, fill_opacity="0.14")
    f.text(x + 128, y + 36, a, 14, TEXT, "middle", bold=True)
    f.text(x + 128, y + 56, b, 12, TEXT, "middle")


def doors(f, x, y, names):
    f.text(x, y + 15, "One-way doors:", 11.5, MUTED)
    cx = x + 96
    for name in names:
        w = 16 + len(name) * 6.6
        f.rect(cx, y, w, 22, fill="none", stroke=RED, rx=11, sw=1.25)
        f.text(cx + w / 2, y + 15, name, 11.5, RED, "middle")
        cx += w + 8


