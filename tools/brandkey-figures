SANS = "Atkinson Hyperlegible Next, Atkinson Hyperlegible, Inter, Segoe UI, system-ui, sans-serif"
MONO = "Atkinson Hyperlegible Mono, ui-monospace, Menlo, Consolas, monospace"
BG, PANEL, LINE, DIM, EDGE = "#0B0D11", "#12161C", "#2A313B", "#161A21", "#5A6370"
TEXT, MUTED, FAINT = "#F2F4F7", "#98A0AC", "#5A6370"
OK, WARN, ETH, RED, CYAN = "#34C759", "#FFB830", "#7A92FF", "#FF5C54", "#70D6FF"
GOLD = "#D9B44A"


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


class Fig:
    def __init__(self, w, h, title):
        self.w, self.h, self.out = w, h, []
        self.add('<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">' % (w, h, w, h))
        self.add("<title>%s</title>" % esc(title))
        self.add('<rect width="%d" height="%d" fill="%s"/>' % (w, h, BG))
        self.add('<defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" '
                 'orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="%s"/></marker></defs>' % EDGE)

    def add(self, s):
        self.out.append(s)

    def text(self, x, y, s, size=13, color=TEXT, anchor="start", bold=False, mono=False):
        weight = ' font-weight="700"' if bold else ""
        self.add('<text x="%s" y="%s" font-size="%s" text-anchor="%s" fill="%s"%s font-family="%s">%s</text>'
                 % (x, y, size, anchor, color, weight, MONO if mono else SANS, esc(s)))

    def rect(self, x, y, w, h, fill="none", stroke=LINE, sw=1.25, rx=8, dash=None, fill_opacity=None):
        extra = (' stroke-dasharray="%s"' % dash if dash else "") + (' fill-opacity="%s"' % fill_opacity if fill_opacity else "")
        self.add('<rect x="%s" y="%s" width="%s" height="%s" rx="%s" fill="%s" stroke="%s" stroke-width="%s"%s/>'
                 % (x, y, w, h, rx, fill, stroke, sw, extra))

    def path(self, pts, color=EDGE, sw=1.5, arrow=True, dash=None):
        d = " ".join(("M" if i == 0 else "L") + "%s %s" % p for i, p in enumerate(pts))
        extra = (' marker-end="url(#arrow)"' if arrow else "") + (' stroke-dasharray="%s"' % dash if dash else "")
        self.add('<path d="%s" fill="none" stroke="%s" stroke-width="%s"%s/>' % (d, color, sw, extra))

    def circle(self, cx, cy, r, fill="none", stroke="none", sw=2):
        self.add('<circle cx="%s" cy="%s" r="%s" fill="%s" stroke="%s" stroke-width="%s"/>' % (cx, cy, r, fill, stroke, sw))

    def padlock(self, x, y, color=MUTED):
        self.add('<path d="M%s %s v-4 a4 4 0 0 1 8 0 v4" fill="none" stroke="%s" stroke-width="1.6"/>' % (x + 3, y, color))
        self.rect(x, y, 14, 10, fill=color, stroke=color, sw=1, rx=2)

    def heading(self, title, sub):
        self.text(24, 40, title, 20, bold=True)
        self.text(24, 64, sub, 13, MUTED)

    def save(self, path):
        self.add("</svg>")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write("\n".join(self.out) + "\n")
        print("wrote", path)


KIND = {  # slot kinds: fill, stroke, name colour, dashed
    "safe": (OK, OK, TEXT, None),
    "brand": (GOLD, GOLD, TEXT, None),
    "record": ("none", MUTED, TEXT, None),
    "empty": ("none", EDGE, MUTED, "4 3"),
    "dead": (DIM, "#20252D", FAINT, None),
}


def slot_tile(f, x, y, w, h, n, kind, name, sub):
    fill, stroke, ink, dash = KIND[kind]
    f.rect(x, y, w, h, fill=fill, stroke=stroke, sw=1.5 if kind in ("safe", "brand") else 1, rx=6, dash=dash,
           fill_opacity="0.16" if kind in ("safe", "brand") else None)
    f.text(x + 8, y + 16, str(n), 11, MUTED, mono=True)
    f.text(x + w - 8, y + 16, "416 B" if n == 8 else ("36 B" if n < 8 else "72 B"), 10, FAINT, "end", mono=True)
    f.text(x + w / 2, y + 38, name, 13, ink, "middle", bold=kind != "dead")
    if sub:
        f.text(x + w / 2, y + 53, sub, 10.5, MUTED, "middle")


