        (112, 72, "1 · Nonce, pass-through mode", ["TempKey ← the verifier's 32-byte challenge"], None),
        (212, 96, "2 · GenKey, digest mode, on slot 0",
         ["TempKey ← SHA-256 of 128 bytes:", "@TempKey | 40 | mode | slot | serial | 0s | pubkey",
          "Returns slot 0's public key (64 bytes)."], None),
        (336, 96, "3 · Sign, internal mode, with slot 1",
         ["Signs SHA-256 of 55 bytes the chip builds from", "TempKey, slot 0's rules, the serial and its seal.",
