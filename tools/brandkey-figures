        f.rect(x0, y0, 440, 432, fill=PANEL, stroke=LINE)
        f.text(x0 + 16, y0 + 28, label, 15, bold=True)
        f.rect(x0 + 16, y0 + 44, 408, 36, fill=DIM, stroke=LINE, rx=6)
        f.text(x0 + 28, y0 + 67, "Rulebook (config zone) · locked before any key exists", 12, MUTED)
        f.padlock(x0 + 398, y0 + 62)
