        f.rect(x0 + 16, y0 + 372, 300, 44, fill="none", stroke=GOLD if v2 else MUTED, rx=6)
        f.text(x0 + 28, y0 + 391, "OTP zone · 64 B, write-once", 12, bold=True)
        f.text(x0 + 28, y0 + 407, "the edition stamp, at the bench" if v2 else "the owner record, at C8", 11, MUTED)
        f.rect(x0 + 324, y0 + 372, 100, 44, fill="none", stroke=MUTED, rx=6)
        f.text(x0 + 374, y0 + 391, "Counter 0", 12, anchor="middle", bold=True)
        f.text(x0 + 374, y0 + 407, "Safe-key uses", 11, MUTED, "middle")
