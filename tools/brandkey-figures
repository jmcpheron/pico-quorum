def attestation():
    f = Fig(960, 648, "The brand key signs only what the chip says about itself")
    f.heading("The brand key signs only what the chip says about itself",
              "Three commands on the chip. The verifier rebuilds the same bytes from public values and checks one signature.")
    f.text(24, 100, "ON THE CHIP", 12, MUTED, bold=True)
    f.text(516, 100, "THE VERIFIER", 12, MUTED, bold=True)
    boxes = (
        (112, 72, "1 · Nonce, pass-through mode", ["TempKey ← the verifier's 32-byte challenge"], None),
        (212, 96, "2 · GenKey, digest mode, on slot 0",
         ["TempKey ← SHA-256 of 128 bytes:", "@TempKey | 40 | mode | slot | serial | 0s | pubkey",
          "Returns slot 0's public key (64 bytes)."], None),
        (336, 96, "3 · Sign, internal mode, with slot 1",
         ["Signs SHA-256 of 55 bytes the chip builds from", "TempKey, slot 0's rules, the serial and its seal.",
          "Returns the statement: a P-256 signature."], GOLD),
    )
    for y, h, name, lines, accent in boxes:
        f.rect(24, y, 420, h, fill=PANEL, stroke=accent or LINE, sw=2 if accent else 1.25)
        f.text(40, y + 26, name, 14, bold=True)
        for i, line in enumerate(lines):
            mono = line.startswith("@")
            f.text(40, y + 48 + i * 18, line.lstrip("@"), 11.5 if mono else 12.5, CYAN if mono else TEXT, mono=mono)
    f.path([(120, 184), (120, 210)])
    f.path([(120, 308), (120, 334)])
    f.rect(516, 112, 420, 148, fill=PANEL, stroke=LINE)
    f.text(532, 138, "What the verifier knows", 14, bold=True)
    for i, line in enumerate(("its own challenge", "slot 0's public key, from step 2", "the chip's serial number",
                              "slot 0's rules in quorum-v2, fixed for every key",
                              "the brand public key, from the issued batch")):
        f.text(532, 162 + i * 20, "·  " + line, 12.5)
    f.rect(516, 284, 420, 148, fill=OK, stroke=OK, sw=2, fill_opacity="0.10")
    f.text(532, 310, "What it checks", 14, bold=True)
    for i, line in enumerate(("1  rebuild TempKey from the challenge and public key",
                              "2  rebuild the 55 bytes and hash them",
                              "3  verify the statement with the brand public key")):
        f.text(532, 334 + i * 20, line, 12.5)
    f.text(532, 400, "Pass: this public key is slot 0's, on this chip,", 12.5, OK, bold=True)
    f.text(532, 418, "made under quorum-v2's rules, and sealed.", 12.5, OK, bold=True)
    f.path([(514, 148), (446, 148)])
    f.text(480, 140, "challenge", 11, MUTED, "middle")
    f.path([(446, 384), (514, 384)])
    f.text(480, 376, "statement", 11, MUTED, "middle")
    # the 55-byte message, as cryptoauthlib's atcah_sign_internal_msg builds it
    f.text(24, 470, "The 55 bytes slot 1 signs (Microchip cryptoauthlib, atcah_sign_internal_msg)", 13, bold=True)
    x0, bw, y = 24, 912 / 55, 492
    segs = ((0, 32, OK, "TempKey: digest of the challenge, serial and slot 0's public key", None),
            (32, 36, MUTED, None, "a"), (36, 40, GOLD, None, "b"), (40, 41, MUTED, None, "c"),
            (41, 43, FAINT, None, "d"), (43, 52, CYAN, "serial number", None), (52, 53, RED, None, "e"),
            (53, 55, FAINT, None, "f"))
    for a, b, color, label, letter in segs:
        f.rect(x0 + a * bw, y, (b - a) * bw, 40, fill=color, stroke=BG, sw=1.5, rx=0, fill_opacity="0.22")
        if label:
            f.text(x0 + (a + b) / 2 * bw, y + 25, label, 12, TEXT, "middle")
        if letter:
            f.text(x0 + (a + b) / 2 * bw, y + 25, letter, 12, TEXT, "middle", bold=True)
    for off in (0, 32, 36, 40, 43, 52, 55):
        f.text(x0 + off * bw, y - 6, str(off), 10, MUTED, "middle", mono=True)
    keys = (("a", "32–35  the Sign opcode (41), its mode, key id 1"),
            ("b", "36–39  slot 0's SlotConfig and KeyConfig: its rules"),
            ("c", "40  TempKey flags: TempKey came from GenKey"),
            ("d", "41–42  zeros on the ATECC608"),
            ("e", "52  00 if slot 0 is sealed, 01 if not"),
            ("f", "53–54  zeros"))
    for i, (letter, words) in enumerate(keys):
        x, ky = 24 + (i // 3) * 472, 560 + (i % 3) * 22
        f.text(x, ky, letter, 12.5, TEXT, bold=True)
        f.text(x + 18, ky, words, 12.5, MUTED)
    f.save("docs/brandkey/attestation.svg")


