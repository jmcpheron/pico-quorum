#!/bin/sh
# The board as a production device: build an image from firmware/manifest.json, back the board up,
# push an image, verify it, pin its chip, read its log. Details: tools/board/fw.mjs.
#   tools/fw build console | backup | verify [--baseline] | logs | pin | push console | restore DIR
#   tools/fw ceremony start [--unpin] [--keep-open F1D2] | ceremony finish
#   tools/fw push console --all    every board on USB in turn (verify, logs, backup... too)
cd "$(dirname "$0")/.." || exit 1
[ -d emu/node_modules ] || (cd emu && npm ci --silent) || exit 1
[ -d tools/mock-tx-service/node_modules ] || (cd tools/mock-tx-service && npm ci --silent) || exit 1
exec node tools/board/fw.mjs "$@"
