#!/bin/sh
# Talk to the Pico over USB serial. The same mpremote commands as tools/pico, no WiFi console needed.
#   tools/usb                      find the port and open the REPL (Ctrl-] to leave)
#   tools/usb push                 copy every firmware/*.py and *.bin, and reset. Never the secrets
#                                  (secrets.py, secrets_*.py, secrets.bak): the board keeps its own
#                                  WiFi, API key and Safe. Refused on a board with the production
#                                  image (tools/fw push manages that one).
#   tools/usb ls | exec 'print(1)' | cp firmware/x.py :x.py | run firmware/chipcheck.py
# Port: $PICO_PORT, else the first /dev/ttyACM* (Linux) or /dev/cu.usbmodem* (macOS).
# push is one mpremote session: no `resume`, so mpremote soft-resets first (the running module's
# timers die, main.py is skipped, the copies land on a quiet board), every cp chained with +, then
# os.sync(), and only then a hard reset. A reset straight after a cp lost writes on LittleFS
# (atecc.py landed at 3584 of 7021 bytes; upstream commit 261b373 fixed the same thing in ship).
# The copy runs under a 180 s alarm: the USB link can wedge, and `tools/usb reset` is the way out.
cd "$(dirname "$0")/.." || exit 1
port="${PICO_PORT:-$(ls /dev/ttyACM* /dev/tty.usbmodem* /dev/cu.usbmodem* 2>/dev/null | head -1)}"
if [ -z "$port" ]; then
  echo "no Pico on USB (looked for /dev/ttyACM* and /dev/tty.usbmodem*; set PICO_PORT=...)" >&2
  exit 1
fi
mp="$(command -v mpremote || echo "$HOME/.local/bin/mpremote")"
case "$1" in
  push)
    # The production image (tools/fw push) marks its main.py; a blanket copy would undo its manifest.
    if "$mp" connect "$port" resume exec "
try:
    print('PRODUCTION-IMAGE' if '# picoquorum-image:' in open('main.py').read() else 'dev')
except OSError:
    print('dev')" 2>/dev/null | grep -q PRODUCTION-IMAGE; then
      echo "this board runs the production image: use tools/fw push (tools/usb push would copy every module)" >&2
      exit 1
    fi
    set -- connect "$port"
    for f in firmware/*.py; do
      case "$(basename "$f")" in secrets.py|secrets_*.py|secrets.example.py) continue;; esac
      set -- "$@" cp "$f" ":$(basename "$f")" +
    done
    for f in firmware/*.bin; do         # qr.bin and the fonts (qf_*.bin)
      [ -f "$f" ] && set -- "$@" cp "$f" ":$(basename "$f")" +
    done
    set -- "$@" exec "import os
if hasattr(os, 'sync'): os.sync()
print('synced')"
    perl -e 'alarm shift; exec @ARGV' 180 "$mp" "$@" || { echo "copy failed; if the link is wedged: tools/usb reset, then push again" >&2; exit 1; }
    "$mp" connect "$port" resume reset
    echo "pushed to $port, rebooting" ;;
  "") exec "$mp" connect "$port" resume repl ;;
  *) exec "$mp" connect "$port" resume "$@" ;;
esac
