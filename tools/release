#!/bin/sh
# Releases: the manifest, the checks, the signed tag (docs/RELEASES.md). Details: tools/releases/cli.mjs.
#   tools/release check | manifest | verify [VERSION] | tag [--push]
cd "$(dirname "$0")/.." || exit 1
[ -d emu/node_modules ] || (cd emu && npm install --silent) || exit 1
exec node tools/releases/cli.mjs "$@"
