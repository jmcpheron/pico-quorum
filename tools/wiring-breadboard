    add("</svg>")
    return "\n".join(wb1.out) + "\n"


def check():
    """The wire list in BREADBOARD.md against WIRES, and the Pico pins in WIRES against PINS."""
    bad = 0
    for n, c, a, b, part, contact in WIRES:
        m = re.match(r"Pico pin (\d+) \((GP\d+)\)", a)
        if m and contact:
            gp, pn = gpio(part, contact)
            if (gp, pn) != (m.group(2), int(m.group(1))):
                print("wire %d: %s, PINS says %s pin %d" % (n, a, gp, pn)); bad += 1
    rows = {}
    for line in open("hardware/wiring/BREADBOARD.md"):
        m = re.match(r"\|\s*(\d+)\s*\|([^|]*)\|([^|]*)\|", line)
        if m:
            rows[int(m.group(1))] = (m.group(2).strip().strip("*"), m.group(3).strip().strip("*"))
    for n, c, a, b, part, contact in WIRES:
        if rows.get(n) != (a, b):
            print("BREADBOARD.md wire %d: %s, want %s" % (n, rows.get(n), (a, b))); bad += 1
    if set(rows) - {w[0] for w in WIRES}:
        print("BREADBOARD.md has extra wires", sorted(set(rows) - {w[0] for w in WIRES})); bad += 1
    print("wires agree" if not bad else "%d mismatches" % bad)
    return bad


if __name__ == "__main__":
    if "--check" in sys.argv:
        sys.exit(1 if check() else 0)
    open("hardware/wiring/build1-breadboard.svg", "w").write(breadboard())
    open("hardware/wiring/knob-ec11.svg", "w").write(knob())
    print("wrote hardware/wiring/build1-breadboard.svg, hardware/wiring/knob-ec11.svg")
