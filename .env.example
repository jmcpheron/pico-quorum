# Copy to .env (gitignored) and fill in. tools/quorum loads it; a variable already set in your
# shell wins. Never commit .env, and never paste its values into a chat or an issue.

# Safe's transaction service API key, from developer.safe.global (Bearer token for api.safe.global).
# Without one the service allows 2 requests a second and 5,000 a month.
SAFE_API_KEY=

# Optional RPCs (defaults are the public ones). An RPC URL with a key in it is a secret too.
# BASE_SEPOLIA_RPC=
# BASE_RPC=
# ETH_RPC=
# QUORUM_FORK_RPC=
